{
  "name": "dsh-free-subagents",
  "description": "Route delegated subagents and Agent Teams over free-tier models: choose a pool of approved free routes once, and every child request fails over to the next free model with a persistent ledger of quota, rate-limit and timeout parks.",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "docs",
    "assets/icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "free-tier",
    "router",
    "fallback"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "status": "node cli.mjs status"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "author": {
    "name": "boldandigital",
    "url": "https://github.com/boldandigital"
  },
  "homepage": "https://github.com/boldandigital/dsh-free-subagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boldandigital/dsh-free-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/boldandigital/dsh-free-subagents/issues"
  }
}
